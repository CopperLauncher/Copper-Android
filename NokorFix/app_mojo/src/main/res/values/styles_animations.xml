<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window animation styles -->
    <style name="Animation.Nokor.None" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/nokor_none</item>
        <item name="android:windowExitAnimation">@anim/nokor_none</item>
    </style>

    <style name="Animation.Nokor.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/nokor_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/nokor_dialog_exit</item>
    </style>

    <style name="Animation.Nokor.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nokor_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/nokor_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/nokor_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/nokor_activity_close_exit</item>
    </style>

    <style name="Animation.Nokor.ActivityNone" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nokor_none</item>
        <item name="android:activityOpenExitAnimation">@anim/nokor_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/nokor_none</item>
        <item name="android:activityCloseExitAnimation">@anim/nokor_none</item>
    </style>

    <!-- Overlays applied by AnimationManager for the animation types the user enabled -->
    <style name="ThemeOverlay.Nokor.Animations.Dialogs" parent="">
        <item name="nokorDialogAnimations">@style/Animation.Nokor.Dialog</item>
    </style>

    <style name="ThemeOverlay.Nokor.Animations.Buttons" parent="">
        <item name="nokorPressAnimator">@animator/nokor_press_scale</item>
    </style>

    <!-- Themed button defaults, the press animator is empty unless the overlay above is applied -->
    <style name="Widget.Nokor.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">?attr/nokorPressAnimator</item>
    </style>

    <!-- Text button (primary coloured label, no fill) with the same press animator -->
    <style name="Widget.Nokor.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">?attr/nokorPressAnimator</item>
    </style>

    <style name="Widget.Nokor.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:stateListAnimator">?attr/nokorPressAnimator</item>
    </style>
</resources>
