<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay shown from the moment the game's JVM process starts until its render window
    actually appears. There is no reliable low-level signal for "the window is now visible",
    so GameLoadingOverlay (net.kdt.pojavlaunch.GameLoadingOverlay) estimates progress/ETA from
    past launch durations and watches the game log for a line that shows up right around when
    the window comes up.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_loading_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone"
    android:importantForAccessibility="no"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ProgressBar
            android:id="@+id/game_loading_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorAccent"
            android:indeterminateTintMode="src_in" />

        <TextView
            android:id="@+id/game_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/game_loading_title"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/game_loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/game_loading_subtitle"
            android:textColor="#B8B8B8"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/game_loading_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp"
            android:layout_height="6dp"
            android:layout_marginTop="20dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/game_loading_progressbar" />

        <TextView
            android:id="@+id/game_loading_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/game_loading_eta_estimating"
            android:textColor="#B8B8B8"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
