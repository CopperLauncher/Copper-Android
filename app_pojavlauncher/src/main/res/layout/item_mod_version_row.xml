<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/version_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_version_row"
    android:layout_marginBottom="@dimen/padding_moderate"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/padding_heavy"
    android:paddingVertical="@dimen/padding_heavy"
    android:minHeight="@dimen/_44sdp">

    <!-- Release-type circle badge (R / B / A) -->
    <TextView
        android:id="@+id/version_row_type_badge"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:background="@drawable/bg_circle_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/version_row_name"
        tools:text="R" />

    <!-- Version name / number -->
    <TextView
        android:id="@+id/version_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_moderate"
        android:textColor="?attr/colorTextPrimary"
        android:textStyle="bold"
        android:textSize="@dimen/_13ssp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@+id/version_row_type_badge"
        app:layout_constraintEnd_toStartOf="@+id/version_row_status"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2.4.1" />

    <!-- Loader / mc version subtitle -->
    <TextView
        android:id="@+id/version_row_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_moderate"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="@dimen/_11ssp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@+id/version_row_type_badge"
        app:layout_constraintEnd_toStartOf="@+id/version_row_status"
        app:layout_constraintTop_toBottomOf="@+id/version_row_name"
        tools:text="Fabric 1.21.6 • December 16, 2025" />

    <!-- Status area: "Current" pill OR incompatible warning icon, whichever applies -->
    <TextView
        android:id="@+id/version_row_current_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_version_current_pill"
        android:paddingHorizontal="@dimen/padding_moderate"
        android:paddingVertical="@dimen/padding_small"
        android:text="@string/switch_mod_version_current"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="@dimen/_9ssp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/version_row_incompatible_icon"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:src="@drawable/ic_incompatible_warning"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Shared end-anchor for the name/subtitle constraints above — reserves
         enough width for either the "Current" pill or the incompatible icon
         so the title/subtitle text never runs underneath them. -->
    <View
        android:id="@+id/version_row_status"
        android:layout_width="@dimen/_56sdp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>