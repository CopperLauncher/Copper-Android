<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/version_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_card"
    android:layout_marginVertical="@dimen/padding_medium"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_44sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_heavy"
    android:paddingVertical="@dimen/padding_moderate">

    <!-- Checkmark: currently installed version -->
    <ImageView
        android:id="@+id/version_row_current_badge"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/padding_moderate"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Incompatible warning icon -->
    <ImageView
        android:id="@+id/version_row_incompatible_icon"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/padding_moderate"
        android:src="@drawable/ic_incompatible_warning"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/version_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="@dimen/_13ssp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="2.4.1" />

        <TextView
            android:id="@+id/version_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="@dimen/_11ssp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Release • Fabric 26.2 • Jun 16, 2026" />

    </LinearLayout>

    <!-- "Current" text label on the far right -->
    <TextView
        android:id="@+id/version_row_current_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_moderate"
        android:textColor="?attr/copperAccent"
        android:textStyle="bold"
        android:textSize="@dimen/_11ssp"
        android:text="@string/switch_mod_version_current"
        android:visibility="gone" />

</LinearLayout>