<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Landscape AppTheme — fullscreen + notch, flat bg -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="colorBgApp">@color/background_app</item>
        <item name="colorBgBottomBar">@color/background_bottom_bar</item>
        <item name="colorBgStatusBar">@color/background_status_bar</item>
        <item name="colorDivider">@color/divider</item>
        <item name="colorAccent">@color/minebutton_color</item>
        <item name="colorTextPrimary">@color/primary_text</item>
        <item name="colorTextSecondary">@color/secondary_text</item>
        <item name="bgMainDrawable">@color/background_app</item>
        <item name="android:windowBackground">@color/background_app</item>
    </style>
    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_copper</item>
        <item name="android:windowBackground">@drawable/bg_gradient_copper</item>
    </style>

