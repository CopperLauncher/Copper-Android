<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="40dp">

        <!-- Same metrics as a stock settings Preference row: 56dp icon frame, icon up to 48dp, list item title -->
        <LinearLayout
            android:id="@+id/cursor_back_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="?android:attr/listPreferredItemHeightSmall"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minWidth="56dp"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="48dp"
                    android:maxHeight="48dp"
                    android:src="@drawable/ic_px_arrow_left" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/preference_back_title"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/cursor_title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cursor_screen_title"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="@dimen/padding_large" />

        <TextView
            android:id="@+id/cursor_subtitle"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cursor_screen_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_large" />

        <View
            style="@style/ThickDivider"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/padding_large" />

        <!-- Custom Card with upload and inline edit buttons -->
        <LinearLayout
            android:id="@+id/card_cursor_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/padding_large">

            <ImageView
                android:id="@+id/preview_custom"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/custom_upload_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cursor_user_custom"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_custom_upload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/cursor_btn_upload" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_custom_edit_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/cursor_btn_edit" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_custom_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/cursor_btn_reset" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cursor Size Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cursor_size_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txt_cursor_size_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_cursor_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="280"
                android:progress="80" />
        </LinearLayout>

        <!-- Interactive Test Zone Touchpad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cursor_test_zone_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/cursor_test_pad"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="?attr/colorSurfaceContainerLowest">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_test_zone_hint"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:layout_gravity="center" />

                <!-- The test pointer widget -->
                <ImageView
                    android:id="@+id/test_pointer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Inline Custom Cursor Editor (Hidden by default) -->
        <LinearLayout
            android:id="@+id/panel_cursor_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cursor_editor_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Transparency Checkboard FrameLayout container -->
            <FrameLayout
                android:id="@+id/editor_checkboard_container"
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <ImageView
                    android:id="@+id/editor_checkboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:layout_gravity="center"
                    android:padding="20dp" />
            </FrameLayout>

            <!-- Editor controls (Flood erase, Manual eraser, Auto-cut) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_flood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="@string/cursor_editor_btn_flood" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_manual_eraser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="@string/cursor_editor_btn_manual" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_autocut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:text="@string/cursor_editor_btn_autocut" />
            </LinearLayout>

            <!-- Adaptive Sensitivity / Size slider -->
            <LinearLayout
                android:id="@+id/layout_brush_or_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txt_slider_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cursor_editor_sensitivity"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/txt_slider_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_brush_or_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150"
                    android:progress="45" />
            </LinearLayout>

            <!-- Actions row: Undo, Cancel, Save -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_undo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="@string/cursor_editor_btn_undo"
                    android:enabled="false" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="@string/cursor_editor_btn_cancel" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_editor_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:text="@string/cursor_editor_btn_save" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.kdt.DefocusableScrollView>
