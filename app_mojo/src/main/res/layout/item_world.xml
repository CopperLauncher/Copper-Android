<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/padding_medium"
    android:background="@drawable/background_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_70sdp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/world_icon"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:layout_margin="@dimen/padding_moderate"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_world" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/world_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/world_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/world_datapacks"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/world_datapacks"
        android:padding="@dimen/padding_small"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_datapack" />

    <ImageButton
        android:id="@+id/world_export"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/world_export"
        android:padding="@dimen/padding_small"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_sharelog" />

    <ImageButton
        android:id="@+id/world_delete"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/padding_moderate"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:padding="@dimen/padding_small"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_trash" />
</LinearLayout>
