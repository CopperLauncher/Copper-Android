<?xml version="1.0" encoding="utf-8"?>
<!-- One choice of the instance icon dialog: the icon and what it is -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_44sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_large"
    android:paddingVertical="@dimen/padding_moderate">

    <ImageView
        android:id="@+id/instance_icon_option_image"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/instance_icon_option_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
