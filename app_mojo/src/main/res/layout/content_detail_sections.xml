<?xml version="1.0" encoding="utf-8"?>
<!-- The three scrolling sections of the detail screen, only one is visible at a time -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Description -->
    <LinearLayout
        android:id="@+id/content_section_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingVertical="@dimen/padding_moderate">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/content_description_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/content_description_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_moderate"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <TextView
            android:id="@+id/content_description_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Gallery -->
    <LinearLayout
        android:id="@+id/content_section_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingVertical="@dimen/padding_moderate"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/content_gallery_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/content_gallery_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content_gallery_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content_gallery_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Changelog -->
    <LinearLayout
        android:id="@+id/content_section_changelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingVertical="@dimen/padding_moderate"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/content_changelog_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/content_changelog_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/content_changelog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/content_changelog_more"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_moderate"
            android:text="@string/content_changelog_more"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
