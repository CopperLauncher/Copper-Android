<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen of the right pane in the two-pane landscape main menu: a board of tiles on top of the launcher wallpaper -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The wallpaper when it isn't fullscreen: only here, like it was before the tiles -->
    <com.kdt.mcgui.LauncherWallpaperView
        android:id="@+id/pane_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Only scrolls when "Infinite tiles" is on, otherwise the board is exactly as tall as the pane -->
    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <git.artdeell.mojo.home.HomeTileBoard
            android:id="@+id/home_tile_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</FrameLayout>
