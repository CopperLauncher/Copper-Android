<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen of the right pane in the two-pane landscape main menu: a board of tiles on top of the launcher wallpaper -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <git.artdeell.mojo.home.HomeTileBoard
        android:id="@+id/home_tile_board"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/home_edit_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="12dp"
        android:background="@drawable/bg_home_edit_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_edit_add"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_add_tile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_edit_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_reset_tiles" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_edit_done"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_edit_done" />
    </LinearLayout>
</FrameLayout>
