<?xml version="1.0" encoding="utf-8"?>
<!-- Right pane of the landscape two-pane main menu: shows the section picked in the left pane,
     the version list by default. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:id="@+id/content_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <include layout="@layout/content_detail_sections" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/content_detail_versions_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
