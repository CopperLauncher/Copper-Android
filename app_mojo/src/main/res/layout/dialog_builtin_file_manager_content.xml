<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <TextView
        android:id="@+id/file_manager_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/file_manager_dialog_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/file_manager_path_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_manager_up"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/file_manager_parent_folder"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text=""
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="?attr/colorSurfaceContainerLow"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="20dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/file_manager_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:background="@drawable/bg_file_manager_path" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_manager_sort"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/file_manager_sort_name"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/file_manager_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_file_manager_path"
        android:hint="@string/file_manager_search_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/file_manager_columns_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/file_manager_column_name"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/file_manager_column_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/file_manager_column_modified"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/file_manager_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_file_manager_list"
        android:clipToOutline="true">

        <ListView
            android:id="@+id/file_manager_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/file_manager_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
