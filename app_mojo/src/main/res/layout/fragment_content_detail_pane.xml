<?xml version="1.0" encoding="utf-8"?>
<!-- Left pane of the landscape two-pane main menu: back button on top, then the header and the
     buttons that pick what the right pane shows (Description, Gallery, Changelog, Versions).
     The right pane is fragment_content_detail_right.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/content_detail_back"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="match_parent"
        android:drawableStart="@drawable/ic_arrow_back_white"
        android:text="@string/preference_back_title" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/content_detail_hero" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/content_nav_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/padding_heavy"
                android:layout_marginVertical="@dimen/padding_medium"
                android:orientation="vertical"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/content_nav_description"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/content_tab_description" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/content_nav_gallery"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/content_tab_gallery" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/content_nav_changelog"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/content_tab_changelog" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/content_nav_versions"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/content_tab_versions" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
