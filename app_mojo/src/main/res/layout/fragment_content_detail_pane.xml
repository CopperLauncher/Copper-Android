<?xml version="1.0" encoding="utf-8"?>
<!-- Left pane of the landscape two-pane main menu: back button on top, then the header card and
     the navigation items that pick what the right pane shows (Description, Gallery, Changelog,
     Versions). The right pane is fragment_content_detail_right.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/content_detail_back"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="match_parent"
        android:drawableStart="@drawable/ic_arrow_back_white"
        android:text="@string/preference_back_title" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_moderate"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <include layout="@layout/content_detail_hero" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/content_nav_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/padding_moderate"
                android:paddingVertical="@dimen/padding_medium">

            <LinearLayout
                android:id="@+id/content_nav_description"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginVertical="@dimen/padding_small"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_large">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_description" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_heavy"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/content_tab_description"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_nav_gallery"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginVertical="@dimen/padding_small"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_large">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_gallery" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_heavy"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/content_tab_gallery"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_nav_changelog"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginVertical="@dimen/padding_small"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_large">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_changelog" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_heavy"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/content_tab_changelog"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content_nav_versions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginVertical="@dimen/padding_small"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_large">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_versions" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_heavy"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/content_tab_versions"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
