<?xml version="1.0" encoding="utf-8"?>
<!--
    Two-pane landscape main menu: tiles in the left sidebar while every screen
    (add instance, accounts, editors, modpack search, ...) opens in the right pane.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <!-- Left sidebar = 33%, right pane = 67% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pane_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <!-- ══════════════ LEFT SIDEBAR: a scrollable board of tiles, the same kind of tiles as the home screen has.
         Long press a tile or the empty space to edit it, tiles can be dragged over to the home screen and back. ══════════════ -->
    <ScrollView
        android:id="@+id/left_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <git.artdeell.mojo.home.HomeTileBoard
            android:id="@+id/sidebar_tile_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <!-- Replaces the sidebar while Browse/Manage Content is open, see ContentPickerFragment -->
    <FrameLayout
        android:id="@+id/left_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════ RIGHT PANE ══════════════
         Hosts the home screen by default and every screen opened from the sidebar or the version bar.
         When the bottom bar is hidden it collapses, and the pane grows to fill the height. -->
    <FrameLayout
        android:id="@+id/right_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_right_pane"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="8dp" />

    <!-- ══════════════ BOTTOM BAR: instance selection and play, only shown on the home screen ══════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_guideline">

        <!-- Replace the version bar and the play button while the tiles are edited, so they never cover a tile -->
        <LinearLayout
            android:id="@+id/home_edit_controls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_home_edit_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_edit_add_left"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/home_add_left"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_edit_add_right"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/home_add_right"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_edit_more"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/home_more"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_edit_done"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/home_edit_done"
                android:textSize="12sp" />
        </LinearLayout>

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_rounded"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_32sdp" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_px_edit" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/_96sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
