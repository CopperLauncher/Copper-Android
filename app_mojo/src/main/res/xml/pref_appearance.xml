<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <git.artdeell.mojo.prefs.BackButtonPreference/>

    <PreferenceCategory android:title="@string/preference_category_theme">
        <androidx.preference.ListPreference
            android:defaultValue="system"
            android:key="theme_mode"
            android:entries="@array/theme_mode_names"
            android:entryValues="@array/theme_mode_values"
            android:title="@string/preference_theme_mode_title"
            android:icon="@drawable/ic_px_theme_mode"
            app:useSimpleSummaryProvider="true" />
        <androidx.preference.ListPreference
            android:defaultValue="dynamic"
            android:key="color_source"
            android:entries="@array/color_source_names"
            android:entryValues="@array/color_source_values"
            android:title="@string/preference_color_source_title"
            android:icon="@drawable/ic_px_color_source"
            app:useSimpleSummaryProvider="true" />
        <git.artdeell.mojo.prefs.ThemeColorPreference
            android:key="theme_custom_color"
            android:title="@string/preference_theme_color_title"
            android:icon="@drawable/ic_px_color_custom" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_display">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:key="force_landscape"
            android:title="@string/preference_force_landscape_title"
            android:summary="@string/preference_force_landscape_description"
            android:icon="@drawable/ic_px_orientation" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_background">
        <Preference
            android:key="set_custom_launcher_bg"
            android:title="@string/preference_set_custom_bg_title"
            android:summary="@string/preference_set_custom_bg_summary"
            android:icon="@drawable/ic_px_bg_set" />
        <Preference
            android:key="remove_custom_launcher_bg"
            android:title="@string/preference_remove_custom_bg_title"
            android:summary="@string/preference_remove_custom_bg_summary"
            android:icon="@drawable/ic_px_bg_remove" />
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:key="launcher_bg_fullscreen"
            android:icon="@drawable/ic_px_ap_fullscreen"
            android:summary="@string/preference_bg_fullscreen_summary"
            android:title="@string/preference_bg_fullscreen_title" />
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:key="launcher_bg_other_screens"
            android:icon="@drawable/ic_px_ap_other_screens"
            android:summary="@string/preference_bg_other_screens_summary"
            android:title="@string/preference_bg_other_screens_title" />
        <git.artdeell.mojo.prefs.CustomSeekBarPreference
            android:defaultValue="0"
            android:key="launcher_bg_blur"
            android:icon="@drawable/ic_px_ap_blur"
            android:max="100"
            android:summary="@string/preference_bg_blur_summary"
            android:title="@string/preference_bg_blur_title"
            app:min="0"
            app:seekBarIncrement="1"
            app:selectable="false"
            app:showSeekBarValue="true" />
        <git.artdeell.mojo.prefs.CustomSeekBarPreference
            android:defaultValue="0"
            android:key="launcher_bg_overlay"
            android:icon="@drawable/ic_px_ap_overlay"
            android:max="100"
            android:summary="@string/preference_bg_overlay_summary"
            android:title="@string/preference_bg_overlay_title"
            app:min="0"
            app:seekBarIncrement="1"
            app:selectable="false"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_home_tiles">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="home_tiles_infinite"
            android:icon="@drawable/ic_px_ap_infinite"
            android:summary="@string/preference_tiles_infinite_summary"
            android:title="@string/preference_tiles_infinite_title" />
        <git.artdeell.mojo.prefs.CustomSeekBarPreference
            android:defaultValue="100"
            android:key="home_tile_opacity"
            android:icon="@drawable/ic_px_ap_tile_opacity"
            android:max="100"
            android:summary="@string/preference_tile_opacity_summary"
            android:title="@string/preference_tile_opacity_title"
            app:min="0"
            app:seekBarIncrement="1"
            app:selectable="false"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="home_tile_blur"
            android:icon="@drawable/ic_px_ap_tile_blur"
            android:summary="@string/preference_tile_blur_summary"
            android:title="@string/preference_tile_blur_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_animations">
        <androidx.preference.MultiSelectListPreference
            android:defaultValue="@array/animation_type_defaults"
            android:dialogTitle="@string/preference_animations_dialog_title"
            android:entries="@array/animation_type_names"
            android:entryValues="@array/animation_type_values"
            android:key="animation_types"
            android:title="@string/preference_animations_title"
            android:icon="@drawable/ic_px_animation" />
    </PreferenceCategory>

</PreferenceScreen>
