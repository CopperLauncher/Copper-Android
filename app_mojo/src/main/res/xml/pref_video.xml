<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <git.artdeell.mojo.prefs.BackButtonPreference />

    <PreferenceCategory android:title="@string/preference_category_video" >
        <androidx.preference.ListPreference
            android:title="@string/mcl_setting_category_renderer"
            android:key="renderer"
            android:defaultValue="opengles2"
            android:icon="@drawable/ic_px_image_renderer"
            app2:useSimpleSummaryProvider="true"/>

        <Preference
            android:key="renderer_settings"
            android:title="@string/mcl_setting_title_renderer_settings"
            android:icon="@drawable/ic_mg_renderer"
            />

        <androidx.preference.MultiSelectListPreference
            android:key="enabledNativePlugins"
            android:title="@string/preference_native_plugins_title"
            android:summary="@string/preference_native_plugins_summary"
            android:dialogTitle="@string/preference_native_plugins_dialog_title" />

        <androidx.preference.SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="ignoreNotch"
            android:summary="@string/mcl_setting_subtitle_ignore_notch"
            android:title="@string/mcl_setting_title_ignore_notch"
            android:icon="@drawable/ic_px_viewport_expand"
            />

        <git.artdeell.mojo.prefs.CustomSeekBarPreference
            android:key="resolutionRatio"
            android:summary="@string/mcl_setting_subtitle_resolution_scaler"
            android:title="@string/mcl_setting_title_resolution_scaler"
            app2:showSeekBarValue="true"
            app2:selectable="false"
            app2:min="@integer/resolution_seekbar_min"
            app2:seekBarIncrement="@integer/resolution_seekbar_increment"
            android:icon="@drawable/ic_px_resolution"
            />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:title="@string/preference_sustained_performance_title"
            android:summary="@string/preference_sustained_performance_description"
            android:key="sustainedPerformance"
            android:defaultValue="false"
            />

        <androidx.preference.SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="alternate_surface"
            android:summary="@string/mcl_setting_subtitle_use_surface_view"
            android:title="@string/mcl_setting_title_use_surface_view"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="force_vsync"
            android:summary="@string/preference_force_vsync_description"
            android:title="@string/preference_force_vsync_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="use_angle"
            android:summary="@string/preference_use_angle_description"
            android:title="@string/preference_use_angle_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:key="use_system_angle"
            android:summary="@string/preference_use_angle_description"
            android:title="@string/preference_use_system_angle_title"
            />
        <androidx.preference.ListPreference
            android:defaultValue="custom"
            android:icon="@drawable/ic_px_volcano"
            android:key="vulkanDriver"
            android:title="@string/preference_vulkan_driver_title"
            app2:useSimpleSummaryProvider="true"/>

        <androidx.preference.Preference
            android:key="panvkDriverManager"
            android:title="@string/preference_panvk_driver_manager_title"
            android:summary="@string/preference_panvk_driver_manager_summary"
            android:fragment="git.artdeell.mojo.prefs.screens.PanVkDriverManagerFragment"
            android:icon="@drawable/ic_sharp_settings_24"/>
    </PreferenceCategory>
</PreferenceScreen>