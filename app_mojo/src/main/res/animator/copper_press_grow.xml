<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.07" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.07" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
</selector>
